function procesarAccionServidor(data) {
  const patron = /^\d{8}$/;
  if (!patron.test(data.telefono)) {
    throw new Error ("NUMERO INVALIDO");
  }
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getSheetByName("Clientes");
  const datos = sheet.getDataRange().getValues();
  const telefonoStr = String(data.telefono);
  const fechaFormateada = new Date(data.fecha);
  const distrito = letDistrict(data.latitud,data.longitud);

  
  // 1. Buscar si el teléfono ya existe (para validación o actualización)
  let rowIndex = -1;
  let rowData = null;

  for (let i = 0; i < datos.length; i++) {
    if (String(datos[i][1]) === telefonoStr) {
      rowIndex = i + 1; // El índice en Sheets empieza en 1
      rowData = datos[i];
      break;
    }
  }

  // --- ESCENARIO 1: SOLO CONSULTA (Validación inicial) ---
  if (data.modo === "CONSULTAR") {
    if (rowData) {
      return {
        mode: "ACTUALIZAR",
        success: true,
        lat: rowData[2], 
        lng: rowData[3], 
        status: "Número encontrado"
      };
    } else {
      // No se puede actualizar porque no tenemos datos del GPS, se devuelve informacion para conseguir el GPS
      //sheet.appendRow([data.telefono, data.latitud, data.longitud, fechaFormateada, data.dispositivo]);
      return { mode: "NUEVO", success: false, status: "Número No Registrado" };
    }
  }

  // --- ESCENARIO 2: GUARDADO O ACTUALIZACIÓN ---
  

  try {
    if (data.modo === "ACTUALIZAR" && rowIndex !== -1) {
      // Sobrescribimos las celdas de la fila existente
      sheet.getRange(rowIndex, 2).setValue(data.latitud);  // Col B
      sheet.getRange(rowIndex, 3).setValue(data.longitud); // Col C
      sheet.getRange(rowIndex, 4).setValue(fechaFormateada); // Col D
      //falta actualizar el dispositivo...
      return { mode: "ACTUALIZAR",success: true, status: "Ubicación Actualizada Correctamente" };
    } 
    
    if (data.modo === "NUEVO" || (data.modo === "EXTERNAL_SAVE" && rowIndex === -1)) {
      // Insertamos una fila nueva
      sheet.appendRow([fechaFormateada,data.telefono, data.latitud, data.longitud, distrito,data.dispositivo]);
      return { mode: "ACTUALIZAR",success: true, status: "Registro Nuevo Guardado Con Exito" };
    }


    if (data.modo === "EXTERNAL_SAVE" && rowIndex !== -1) {
      // Si venía de afuera pero ya existía, frenamos y avisamos
      return { mode: "ACTUALIZAR",success: false, status: "EL_NUMERO_YA_EXISTE", lat: rowData[1], lng: rowData[2] };
    }

  } catch (e) {
    return { success: false, error: e.toString() };
  }
}

function letDistrict(lat,long) { //obtiene el distrito o barrio usando API  de google maps.
  try {
    const response = Maps.newGeocoder().reverseGeocode(lat,long);
    //console.log(response);
    if (response.status === 'OK' && response.results.length > 0) {
      // El distrito suele estar en 'administrative_area_level_3' o 'locality'
      const componentes = response.results[0].address_components;
      componentes.reverse();

      let distrito = "No Encontrado";
      
      distrito = componentes.find((componente)=>{
        const tipos = componente.types;
        //console.log(tipos)
        if (tipos.includes("locality") || tipos.includes("administrative_area_level_3")) {
          return componente;

        }

      });
      return distrito.long_name;
    }
    
    return "No Encontrado";

  } catch (e) {
    console.log("Error: " + e.toString());
    return "No Disponible";
    
  }
}



function actualizarDistrict (){//funciona auxiliar para actualizar distritos de manera masiva desde google maps.
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getSheetByName("Clientes");
  const datos = sheet.getDataRange().getValues();  
  for (let i = 1; i < datos.length; i++) {
    const distrito = letDistrict(datos[i][2],datos[i][3]);
    sheet.getRange(i+1,5).setValue(distrito); 
    Utilities.sleep(1000);
  }
  
}





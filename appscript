// recibe un numero de telefono, consulta si existe en BD y devuelve un objeto "results" con booleano si "existe" junto con los datos de la fila y un mensaje de estado. Si no existe solo devuelve el booleano en false y mensaje de estado.
function dataValidation (celular){

  //var celular = 11111111;
  const hoja = SpreadsheetApp.getActiveSpreadsheet().getActiveSheet();
  const datos = hoja.getDataRange().getValues(); // Trae toda la tabla
  const newPhone = String(celular);
  
  // Buscamos la fila donde la primera columna (índice 0) coincida
  const dataRow = datos.find(row => row[0].toString() === newPhone); //usa find, para encontrar y retornar ese dato.
  let results = "";
  console.log(dataRow)
  if (dataRow) {
    // Si existe, retornamos un objeto con la info de esa fila
    results = {
      existe: true,
      status: "EXISTE EN BD, ELIMINANDO DE LOCAL",
      nombre: dataRow[0], // Columna B
      coordenate: dataRow[2]  // Columna C
    };
    return results
  } else {
    results = {
      existe: false,
      status: "NO EXISTE EN BD, GUARDANDO EN GSHEETS",
    };
    return results
  }
}

// Recibe un objeto "data" ya validado por dataValidation(), llama a la BD de GSHEETS, extrae el timestamp y lo formatea en Fecha y Hora... Injecta los valores en una fila nueva de GSHEETS. Retorna un objeto, con valor success y mensaje:
function saveInSheets (data){
  try{
    var sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName("Clientes");
    const fecha = new Date(data.fecha); //convierte el timestamp del front de milisegundos a formato fecha.
    sheet.appendRow([data.telefono,data.latitud,data.longitud,fecha,data.dispositivo]); //injecta los datos recibidos desde el Front. en G SHEETS.

    // Retorna para que el SuccessHandler del HTML lo reciba
    return { success: true, status: "Guardado correctamente" };

  } catch (error) {
    // Si algo sale mal, envia el error original al navegador
    return { success: false, error: error.toString() };
  }
}

